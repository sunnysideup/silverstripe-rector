parameters:
    level: 4
    # Minimum supported PHP is 8.3 (see composer.json); CI also runs newer versions
    phpVersion:
        min: 80300
        max: 80500
    paths:
        - src
        - tests
        - config
    excludePaths:
        - tests/PHPStan/Rules/Rector/Fixture/*
    treatPhpDocTypesAsCertain: false

rules:
    - Netwerkstatt\SilverstripeRector\PHPStan\Rules\Rector\DocumentedRectorRule
